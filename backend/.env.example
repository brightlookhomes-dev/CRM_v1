PORT=4000
NODE_ENV=development
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite, stored in PGLITE_DIR).
# For a real server: DATABASE_URL=postgres://user:password@localhost:5432/brightlook
DATABASE_URL=
PGLITE_DIR=./data/pgdata
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
SEED_ADMIN_PASSWORD=app@123
